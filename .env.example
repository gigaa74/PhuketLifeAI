TELEGRAM_BOT_TOKEN=
GIGACHAT_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Optional: path to a trusted PEM CA bundle if the local environment
# cannot validate GigaChat certificates with the system trust store.
GIGACHAT_CA_BUNDLE=

# Optional: numeric Telegram user ID allowed to manage Partner Network.
TELEGRAM_ADMIN_USER_ID=

# Partner offers go to admin review by default. Enable hybrid manually only
# after trusted partners have auto_handoff_enabled=true.
PARTNER_HANDOFF_MODE=review

# Observe-only Telegram scout bots. Keep real tokens only in local .env.
PARTNER_SCOUT_BOT_TOKEN=
CLIENT_SCOUT_BOT_TOKEN=
PARTNER_SCOUT_ALLOWED_CHAT_IDS=
CLIENT_SCOUT_ALLOWED_CHAT_IDS=
SCOUT_OUTREACH_ENABLED=false
